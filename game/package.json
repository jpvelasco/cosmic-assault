{
  "name": "cosmic-assault-game",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:e2e": "vite build --mode e2e && node scripts/check-no-bridge.mjs --e2e",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p src/sw",
    "lint": "eslint .",
    "test": "vitest run",
    "test:balance": "vitest run -c vitest.balance.config.ts",
    "test:digests": "vitest run -c vitest.balance.config.ts tests/balance/d1-expertDigests.test.ts",
    "test:e2e": "playwright test --project=chromium-desktop --project=mobile-landscape --project=release-smoke --project=pages",
    "test:perf": "playwright test --project=perf",
    "check:base": "node scripts/check-base.mjs",
    "check:no-bridge": "node scripts/check-no-bridge.mjs",
    "check:pages": "node scripts/check-pages.mjs",
    "check:workflow": "node scripts/check-workflow.mjs",
    "find-seeds": "node scripts/find-seeds.mjs",
    "icons": "node scripts/render-icons.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
